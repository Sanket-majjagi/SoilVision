{
  "_source": "Government of India — Soil Health Card Scheme (ICAR)",
  "_note": "All values from official ICAR thresholds used in SHC programme",
  "macronutrients": {
    "nitrogen": {
      "unit": "kg/ha",
      "method": "Alkaline KMnO4",
      "low_max": 280,
      "medium_min": 280,
      "medium_max": 560,
      "high_min": 560,
      "target_high_min": 560,
      "thresholds": { "low": 280, "medium": 560 }
    },
    "phosphorus": {
      "unit": "kg/ha",
      "method": "Olsen's method",
      "low_max": 10,
      "medium_min": 10,
      "medium_max": 25,
      "high_min": 25,
      "target_high_min": 25,
      "thresholds": { "low": 10, "medium": 25 }
    },
    "potassium": {
      "unit": "kg/ha",
      "method": "NH4OAc extraction",
      "low_max": 120,
      "medium_min": 120,
      "medium_max": 280,
      "high_min": 280,
      "target_high_min": 280,
      "thresholds": { "low": 120, "medium": 280 }
    },
    "organic_carbon": {
      "unit": "%",
